local HitboxFunction = nil
local function FindHitboxFunction()
    for Index, Object in pairs(getgc(false)) do
        if (typeof(Object) ~= "function") then
            continue
        end
        if (islclosure(Object)) then
            local Info = debug.getinfo(Object)
            if (getfenv(Object).script == LocalPlayer.Character.Core) then
                if (Info.currentline ~= 683) then
                    continue
                end
                HitboxFunction = Object
            end
        end
    end
end
FindHitboxFunction()
LocalPlayer.CharacterAdded:Connect(FindHitboxFunction)

local function Character()
    if LocalPlayer.Character then
        return LocalPlayer.Character
    end
    LocalPlayer.CharacterAdded:Wait()
    return Character()
end

while (Configuration.Kill_Aura) do
    for Index, Player in ipairs(Players:GetPlayers()) do
        if (Player.Character and Player ~= LocalPlayer and Character():FindFirstChild("Fight")) then
            local HRPPlayer = Player.Character:FindFirstChild("HumanoidRootPart")
            local HumanoidPlayer = Player.Character:FindFirstChild("Humanoid")
            local HRPSelf = Character():FindFirstChild("HumanoidRootPart")

            if (HRPPlayer and HRPSelf and HumanoidPlayer.Health > 0) then
                if (Player.Character:FindFirstChild("Highlight")) then
                    local Highlight = Player.Character:FindFirstChild("Highlight")

                    if Highlight.OutlineColor == Color3.fromRGB(143, 255, 137) then
                        continue
                    end
                end
                local Magnitude = (HRPPlayer.Position - HRPSelf.Position).Magnitude

                if Magnitude <= Configuration.Kill_Aura_Range then
                    local Old_Position = HRPSelf.Position
                    local Old_CFrame = CurrentCamera.CFrame

                    HRPSelf.CFrame = CFrame.new(HRPPlayer.Position + (-2 * HumanoidPlayer.MoveDirection))
                    task.wait(.05)

                    CurrentCamera.CFrame = CFrame.lookAt(HRPSelf.Position, HRPPlayer.Position)
                    task.spawn(HitboxFunction, "attack", Configuration.Attack_Limbs[math.random(1, 2)], false, false)
                    task.wait(.05)

                    if Configuration.Void_Spam then
                        HRPSelf.CFrame = CFrame.new(HRPPlayer.Position - Vector3.new(0, 5, 0))
                    end
                    task.wait(.05)

                    HRPSelf.CFrame = CFrame.new(Old_Position)
                    CurrentCamera.CFrame = Old_CFrame
                end
            end
        end
    end
    task.wait()
    end
})

