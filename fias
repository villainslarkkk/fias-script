local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/NIcoGabrielRealYtr/Midnight-Hub-Library/refs/heads/main/Source"))()

local Window = Library:Window({
    Name = "Villain.gg"
})

local Watermark = Library:Watermark("villain.gg")

local KeyList = Library:KeybindList()

local selfPage = Window:Page({
    Name = "Self",
    SubPages = true,
    Icon = "rbxassetid://101118444346965"
})

local selfSubPage = selfPage:SubPage({
    Name = "Local Player Options",
    Columns = 2
})

local selfSection = selfSubPage:Section({
    Name = "player options",
    Side = 1
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

selfSection:Dropdown({
    Name = "fight styles",
    Flag = "styles",
    Default = "HitMan",
    Items = {
        "Hitman",
        "Philly",
        "Boxer",
        "Stud",
        "Ninja",
        "Hawk",
        "Savage",
        "Bones",
        "Squabble",
        "Baddie",
        "Slap Boxer"
    },
    Callback = function(style)
        local class = LocalPlayer:WaitForChild("leaderstats"):WaitForChild("Class")

        if class:IsA("StringValue") then
            class.Value = style
        end
    end
})

local selfSubPage = selfPage:SubPage({
    Name = "Local Teleport Options",
    Columns = 2
})

local selfSection = selfSubPage:Section({
    Name = "Teleport options",
    Side = 1
})

local Locations = {
    Gym = CFrame.new(-440.546021, 38.5798569, -576.225708),
    Outside = CFrame.new(-407.656281, 38.569561, -364.13678),
    Cafeteria = CFrame.new(-189.53717, 28.5695591, 387.99234),
}

local SelectedTeleport = "Gym"

selfSection:Dropdown({
    Name = "Locations",
    Flag = "locations",
    Default = "Gym",
    Items = {
        "Gym",
        "Outside",
        "LockerRoom",
        "Library",
        "Cafeteria",
        "Roof"
    },
    Callback = function(Value)
        SelectedTeleport = Value
    end
})

local ActionButtons = selfSection:Button({
    Name = "Teleport"
})

ActionButtons:Add("teleport to selected location", function()
    local pos = Locations[SelectedTeleport]

    if pos then
        local character = game.Players.LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if hrp then
            hrp.CFrame = pos
        end
    end
end)

local CombatPage = Window:Page({
    Name = "Combat",
    SubPages = true,
    Icon = "rbxassetid://85112456002145"
})

local CombatSubPage = CombatPage:SubPage({
    Name = "Local Combat Options",
    Columns = 2
})

local CombatSection = CombatSubPage:Section({
    Name = "Combat options",
    Side = 1
})




Library:CreateSettingsPage(Window, Watermark, KeyList)
