local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/NIcoGabrielRealYtr/Midnight-Hub-Library/refs/heads/main/Source"))()

local Window = Library:Window({
    Name = "Villain.gg"
})

local Watermark = Library:Watermark("villain.gg")

local KeyList = Library:KeybindList()

local selfPage = Window:Page({
    Name = "Self",
    SubPages = true,
    Icon = "rbxassetid://101118444346965"
})

local selfSubPage = selfPage:SubPage({
    Name = "Local Player Options",
    Columns = 2
})

local selfSection = selfSubPage:Section({
    Name = "player options",
    Side = 1
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

selfSection:Dropdown({
    Name = "fight styles",
    Flag = "styles",
    Default = "HitMan",
    Items = {
        "Hitman",
        "Philly",
        "Boxer",
        "Stud",
        "Ninja",
        "Hawk",
        "Savage",
        "Bones",
        "Squabble",
        "Baddie",
        "Slap Boxer"
    },
    Callback = function(style)
        local class = LocalPlayer:WaitForChild("leaderstats"):WaitForChild("Class")

        if class:IsA("StringValue") then
            class.Value = style
        end
    end
})

local selfSubPage = selfPage:SubPage({
    Name = "Local Teleport Options",
    Columns = 2
})

local selfSection = selfSubPage:Section({
    Name = "Teleport options",
    Side = 1
})

local Locations = {
